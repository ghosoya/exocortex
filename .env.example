# ==============================================================================
# Exocortex v1.4.0 — Environment Configuration Template
# Kopiere diese Datei nach '.env' und passe die Pfade an dein System an.
# ==============================================================================

# Pfad zu deinem Obsidian Vault
EXOCORTEX_VAULT_PATH=~/Daten/Vaults/exocortex

# Unterordner innerhalb des Vaults
EXOCORTEX_SCRATCHPAD_DIR=Scratchpad
EXOCORTEX_SESSIONS_DIR=Sessions
EXOCORTEX_TOPOLOGIES_DIR=Topologies

# LLM & Embedding Backend (Ollama)
EXOCORTEX_OLLAMA_HOST=http://127.0.0.1:11434
EXOCORTEX_CHAT_MODEL=gemma4:12b
EXOCORTEX_EMBEDDING_MODEL=bge-m3
EXOCORTEX_NUM_CTX=65536

# FastMCP Server Daemon
EXOCORTEX_MCP_HOST=127.0.0.1
EXOCORTEX_MCP_PORT=8000
